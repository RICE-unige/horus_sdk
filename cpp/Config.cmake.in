@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(nlohmann_json 3.9)
find_dependency(Threads)
find_dependency(OpenSSL COMPONENTS Crypto)
find_dependency(Eigen3 3.3 NO_MODULE)
find_dependency(zstd CONFIG)
find_dependency(assimp CONFIG)
find_dependency(tinyxml2 CONFIG)
find_dependency(ZLIB)
find_dependency(PNG)
find_dependency(JPEG)
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/../horus_native_core")
find_dependency(WebP)
find_dependency(TIFF)
if(@HORUS_ENABLE_NVENC@)
  find_dependency(PkgConfig)
  pkg_check_modules(HORUS_AV REQUIRED IMPORTED_TARGET libavcodec>=60 libavutil>=58)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/../horus_native_core/horus_native_coreTargets.cmake")

if(@ROS2_FOUND@)
  find_dependency(rclcpp)
  find_dependency(std_msgs)
  find_dependency(rcl_interfaces)
  find_dependency(sensor_msgs)
  find_dependency(nav_msgs)
  find_dependency(geometry_msgs)
  find_dependency(rosbag2_cpp)
  find_dependency(rosidl_typesupport_introspection_cpp)
  include("${CMAKE_CURRENT_LIST_DIR}/../horus_native_ros/horus_native_rosTargets.cmake")
endif()

# Include target exports
include("${CMAKE_CURRENT_LIST_DIR}/horus_cpp_sdkTargets.cmake")

check_required_components(horus_cpp_sdk)
