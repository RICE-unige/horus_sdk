<?xml version="1.0"?>
<robot name="articulated">
  <material name="blue"><color rgba="0.1 0.2 0.8 1"/></material>
  <link name="base">
    <visual><geometry><mesh filename="triangle.obj"/></geometry></visual>
    <collision><origin xyz="0.1 0 0"/><geometry><box size="1 0.5 0.2"/></geometry></collision>
  </link>
  <link name="fixed">
    <visual><origin xyz="0.25 0 0"/><geometry><mesh filename="triangle.obj" scale="2 1 1"/></geometry><material name="blue"/></visual>
  </link>
  <link name="leg">
    <visual><geometry><mesh filename="triangle.obj"/></geometry></visual>
    <collision><origin xyz="0 0 0.2"/><geometry><sphere radius="0.1"/></geometry></collision>
  </link>
  <joint name="fixed_joint" type="fixed">
    <parent link="base"/><child link="fixed"/><origin xyz="1 0 0" rpy="0 0 1.5707963267948966"/>
  </joint>
  <joint name="leg_joint" type="revolute">
    <parent link="fixed"/><child link="leg"/><origin xyz="0 2 0"/><axis xyz="0 2 0"/>
  </joint>
</robot>
